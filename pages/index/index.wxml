<view class="page">
  <view class="hud">
    <view class="hud-top">
      <view class="realm">{{hud.realm}}</view>
      <view class="where">{{hud.where}}</view>
      <view class="wick">
        <image class="wick-icon" src="/assets/wick.svg" mode="aspectFit" />
        <text>{{hud.wick}}</text>
      </view>
      <view class="help {{muted ? 'help-off' : ''}}" bindtap="onMute">♪</view>
      <view class="help {{tip.at === 'help' ? 'tip-ring' : ''}}" bindtap="onGuide">?</view>
    </view>
    <view class="qi">
      <text class="qi-num">{{hud.qi}}</text>
      <text class="qi-cap">/ {{hud.cap}} 灵气</text>
    </view>
    <view class="bar bar-qi">
      <view class="bar-fill" style="width: {{hud.qiPct}}%;"></view>
    </view>
    <view class="chips">
      <view class="chip">每秒<text class="chip-num">+{{hud.rate}}</text></view>
      <view class="chip {{hud.lifeLow ? 'chip-warn' : ''}}">寿元余<text class="chip-num">{{hud.years}} 年</text></view>
      <view class="chip {{hud.demonHigh ? 'chip-warn' : ''}}">心魔<text class="chip-num">{{hud.demon}}</text></view>
    </view>
    <view class="chips chips-sub">
      <view class="chip">机缘<text class="chip-num">{{hud.chanceRate}}</text></view>
      <view class="chip">大机缘<text class="chip-num">{{hud.big}}</text></view>
      <view wx:if="{{hud.mode}}" class="chip chip-warn"><text class="chip-num">{{hud.mode}}</text></view>
    </view>
    <view wx:if="{{hud.aftermath}}" class="chips chips-sub">
      <view class="chip chip-warn"><text class="chip-num">{{hud.aftermath}}</text></view>
    </view>
    <view wx:if="{{tip.at === 'hud'}}" class="tip tip-below" catchtap="noop">
      <view class="tip-text">{{tip.text}}</view>
      <view class="tip-row">
        <text class="tip-skip" bindtap="onTipSkip">跳过指引</text>
        <text wx:if="{{tip.next}}" class="tip-next" bindtap="onTipNext">{{tip.next}}</text>
      </view>
    </view>
    <view wx:if="{{tip.at === 'help'}}" class="tip tip-below tip-help" catchtap="noop">
      <view class="tip-text">{{tip.text}}</view>
      <view class="tip-row">
        <text class="tip-skip" bindtap="onTipSkip">跳过指引</text>
        <text wx:if="{{tip.next}}" class="tip-next" bindtap="onTipNext">{{tip.next}}</text>
      </view>
    </view>
  </view>

  <view class="stage stage-{{actor.layer}} {{actor.storm ? 'stage-storm' : ''}}">
    <view class="scene-far"></view>
    <view class="scene-near"></view>
    <view class="rib rib-1"></view>
    <view class="rib rib-2"></view>
    <view class="rib rib-3"></view>
    <view class="lamp {{actor.flare ? 'lamp-flare' : ''}}">
      <view class="lamp-glow"></view>
      <image class="lamp-img" src="/assets/lamp.svg" mode="aspectFit" />
    </view>
    <view wx:if="{{actor.wisp}}" class="wisp"></view>
    <view wx:if="{{actor.storm}}" class="storm-back">
      <view class="storm-dark"></view>
      <view class="storm-rain"></view>
      <view class="storm-cloud storm-cloud-1"></view>
      <view class="storm-cloud storm-cloud-2"></view>
      <view class="storm-cloud storm-cloud-3"></view>
    </view>
    <view wx:if="{{actor.show}}" class="actor realm-{{actor.realm}} act-{{actor.action}} {{actor.old ? 'is-old' : ''}} {{actor.demon ? 'is-demon' : ''}} {{actor.devil ? 'is-devil' : ''}} {{actor.ready ? 'is-ready' : ''}}">
      <view class="a-aura"></view>
      <view class="a-mist"></view>
      <view class="a-ring"></view>
      <view class="a-cloud"></view>
      <image class="a-bolt" src="/assets/bolt.svg" mode="aspectFit" />
      <view class="a-shadow"></view>
      <view class="a-float">
        <view class="a-body">
          <view class="a-halo"></view>
          <view class="a-ribbon a-ribbon-l"></view>
          <view class="a-ribbon a-ribbon-r"></view>
          <view class="a-legs"></view>
          <view class="a-torso">
            <view class="a-sash" style="background: {{actor.sash}};"></view>
          </view>
          <view class="a-head">
            <view class="a-hair"></view>
            <view class="a-bun"></view>
            <view class="a-brow a-brow-l"></view>
            <view class="a-brow a-brow-r"></view>
            <view class="a-eye a-eye-l"></view>
            <view class="a-eye a-eye-r"></view>
            <view class="a-mouth"></view>
            <view class="a-beard"></view>
          </view>
          <view class="a-arm a-arm-l">
            <view class="a-hand"></view>
          </view>
          <view class="a-arm a-arm-r">
            <view class="a-sword"></view>
            <view class="a-hand"></view>
          </view>
        </view>
      </view>
      <view class="a-dot a-dot-1"></view>
      <view class="a-dot a-dot-2"></view>
      <view class="a-dot a-dot-3"></view>
      <view class="a-prop"></view>
      <view class="a-slash"></view>
      <view wx:if="{{actor.bubble}}" class="a-bubble">{{actor.bubble}}</view>
    </view>
    <view wx:if="{{actor.storm}}" class="storm-front">
      <view class="storm-scorch"></view>
      <image class="storm-bolt storm-bolt-1" src="/assets/bolt.svg" mode="aspectFit" />
      <image class="storm-bolt storm-bolt-2" src="/assets/bolt.svg" mode="aspectFit" />
      <image class="storm-bolt storm-bolt-3" src="/assets/bolt.svg" mode="aspectFit" />
      <view class="storm-flash"></view>
    </view>
  </view>

  <view class="hero-row">
    <view class="hero-line">{{hero.line}}</view>
    <view wx:if="{{alive}}" class="auto {{autoUnlocked && auto ? 'auto-on' : ''}}" bindtap="onAuto">自动机缘 · {{autoUnlocked ? (auto ? '开' : '关') : autoCost + ' 灯芯解锁'}}</view>
  </view>
  <view class="hero">
    <view wx:if="{{tip.at === 'main'}}" class="tip tip-above" catchtap="noop">
      <view class="tip-text">{{tip.text}}</view>
      <view class="tip-row">
        <text class="tip-skip" bindtap="onTipSkip">跳过指引</text>
        <text wx:if="{{tip.next}}" class="tip-next" bindtap="onTipNext">{{tip.next}}</text>
      </view>
    </view>
    <view class="main-btn {{hero.off ? 'main-btn-off' : ''}} {{tip.at === 'main' ? 'tip-ring' : ''}}" hover-class="btn-hover" hover-stay-time="60" bindtap="onMain">
      <text class="main-title">{{hero.title}}</text>
      <text class="main-sub">{{hero.sub}}</text>
    </view>
    <view wx:if="{{hero.trib}}" class="main-btn trib-btn" hover-class="btn-hover" hover-stay-time="60" bindtap="onTrib">
      <text class="main-title">{{hero.trib}}</text>
      <text class="main-sub">{{hero.tribSub}}</text>
    </view>
    <view wx:if="{{hero.sea}}" class="main-btn sea-btn" hover-class="btn-hover" hover-stay-time="60" bindtap="onSea">
      <text class="main-title">{{hero.sea}}</text>
      <text class="main-sub">登上沉舟</text>
    </view>
    <view wx:if="{{hero.big}}" class="main-btn big-btn" hover-class="btn-hover" hover-stay-time="60" bindtap="onBig">
      <text class="main-title">{{hero.big}}</text>
      <text class="main-sub">{{hero.bigSub}}</text>
    </view>
    <view wx:if="{{hero.powder}}" class="main-btn powder-btn {{hero.powderOff ? 'main-btn-off' : ''}}" hover-class="btn-hover" hover-stay-time="60" bindtap="onPowder">
      <text class="main-title">{{hero.powder}}</text>
      <text class="main-sub">{{hero.powderSub}}</text>
    </view>
  </view>
  <view class="tabs">
    <view wx:if="{{tip.at === 'tabs'}}" class="tip tip-above" catchtap="noop">
      <view class="tip-text">{{tip.text}}</view>
      <view class="tip-row">
        <text class="tip-skip" bindtap="onTipSkip">跳过指引</text>
        <text wx:if="{{tip.next}}" class="tip-next" bindtap="onTipNext">{{tip.next}}</text>
      </view>
    </view>
    <view class="tab {{tab === 'skill' ? 'tab-on' : ''}}" data-tab="skill" bindtap="onTab">功法</view>
    <view class="tab {{tab === 'log' ? 'tab-on' : ''}}" data-tab="log" bindtap="onTab">见闻</view>
    <view class="tab {{tab === 'lamp' ? 'tab-on' : ''}}" data-tab="lamp" bindtap="onTab">灯纹</view>
    <view class="tab {{tab === 'me' ? 'tab-on' : ''}}" data-tab="me" bindtap="onTab">轮回</view>
  </view>

  <scroll-view scroll-y class="list">
    <block wx:if="{{tab === 'skill'}}">
      <view class="attrs">
        <view wx:for="{{attrs}}" wx:key="name" class="attr {{item.need ? 'attr-need' : ''}}">
          <text class="attr-name">{{item.name}}</text>
          <text class="attr-value">{{item.value}}</text>
          <text wx:if="{{item.need}}" class="attr-hint">天劫需 {{item.need}}</text>
        </view>
      </view>
      <view class="section">羁绊</view>
      <view wx:for="{{sets}}" wx:key="id" class="set">
        <view class="set-badge" style="background: {{item.color}};">{{item.name}}</view>
        <view class="set-info">
          <view class="set-line {{item.on2 ? 'set-on' : ''}}">2 门：{{item.set2}}</view>
          <view class="set-line {{item.on4 ? 'set-on' : ''}}">4 门：{{item.set4}}</view>
        </view>
        <view class="set-count">{{item.count}} 门</view>
      </view>
      <view class="section">功法 {{skillCount}}</view>
      <view wx:if="{{!skills.length}}" class="empty">还没有功法。翻开机缘，遇到传承时可以学到。</view>
      <view wx:for="{{skills}}" wx:key="id" class="card">
        <view class="badge" style="background: {{item.color}};">{{item.school}}</view>
        <view class="info">
          <view class="name">
            <text>{{item.name}}</text>
            <text class="tag {{item.arcane ? 'tag-arcane' : ''}}">{{item.grade}}</text>
            <text wx:if="{{item.suppressed}}" class="tag tag-suppressed">余波压制</text>
          </view>
          <view class="desc">{{item.desc}}</view>
        </view>
        <view wx:if="{{item.canMerge}}" class="merge-btn" data-id="{{item.id}}" bindtap="onMerge">合秘法</view>
      </view>
    </block>

    <block wx:elif="{{tab === 'log'}}">
      <view wx:if="{{karma.length}}" class="section">未了的因果</view>
      <view wx:for="{{karma}}" wx:key="name" class="karma">【{{item.name}}】尚未结果</view>
      <view wx:if="{{marks.length}}" class="section">这一世的经历</view>
      <view wx:if="{{marks.length}}" class="marks">
        <view wx:for="{{marks}}" wx:key="name" class="mark">{{item.name}}</view>
      </view>
      <view class="section">这一世的见闻</view>
      <view wx:if="{{!logs.length}}" class="empty">这一世还什么都没发生。</view>
      <view wx:for="{{logs}}" wx:key="key" class="log">
        <view class="log-title">{{item.title}}</view>
        <view class="log-text">{{item.text}}</view>
        <view wx:if="{{item.detail}}" class="log-detail">{{item.detail}}</view>
      </view>
    </block>

    <block wx:elif="{{tab === 'lamp'}}">
      <view class="summary">
        <image class="summary-icon" src="/assets/wick.svg" mode="aspectFit" />
        <text>灯芯 {{hud.wick}}。每一世结束时按境界结算，用来点亮永久生效的灯纹。</text>
      </view>
      <view wx:for="{{lamps}}" wx:key="id" class="card">
        <view class="badge badge-lamp">{{item.branch}}</view>
        <view class="info">
          <view class="name">
            <text>{{item.name}}</text>
            <text class="tag">{{item.levelText}}</text>
          </view>
          <view class="desc">{{item.desc}}</view>
        </view>
        <view wx:if="{{item.maxed}}" class="btn btn-off">
          <text class="btn-title">已点满</text>
        </view>
        <view wx:else class="btn {{item.affordable ? '' : 'btn-off'}}" hover-class="btn-hover" hover-stay-time="60" data-id="{{item.id}}" bindtap="onBuyLamp">
          <text class="btn-title">点亮</text>
          <view class="btn-cost">
            <image class="btn-coin" src="/assets/wick.svg" mode="aspectFit" />
            <text>{{item.costText}}</text>
          </view>
        </view>
      </view>
    </block>

    <block wx:else>
      <view class="stats">
        <view wx:for="{{stats}}" wx:key="label" class="stat">
          <text class="stat-label">{{item.label}}</text>
          <text class="stat-value">{{item.value}}</text>
        </view>
      </view>
      <view wx:if="{{dead}}" class="cloud-entry" hover-class="opt-hover" hover-stay-time="60" bindtap="onChronicle">
        <view class="cloud-entry-main">
          <text class="cloud-entry-title">本纪与分享长图</text>
          <text class="cloud-entry-sub">查看这一世的年表，生成可直接转发的长图</text>
        </view>
      </view>
      <view class="section">墓志铭</view>
      <view wx:if="{{!epitaphs.length}}" class="empty">你还没有死过。</view>
      <view wx:for="{{epitaphs}}" wx:key="key" class="log">
        <view class="log-text">{{item.text}}</view>
      </view>
      <view class="cloud-entry" hover-class="opt-hover" hover-stay-time="60" bindtap="onCloud">
        <view class="cloud-entry-main">
          <text class="cloud-entry-title">云存档与排行榜</text>
          <text class="cloud-entry-sub">{{cloud.text}}{{cloud.lastSync ? ' · ' + cloud.lastSync : ''}}</text>
        </view>
        <view class="cloud-dot cloud-dot-{{cloud.state}}"></view>
      </view>
      <view wx:if="{{alive}}" class="cloud-entry" hover-class="opt-hover" hover-stay-time="60" bindtap="onArena">
        <view class="cloud-entry-main">
          <text class="cloud-entry-title">竞技场</text>
          <text class="cloud-entry-sub">挑战榜上修士，累积论道积分和称号</text>
        </view>
      </view>
      <view wx:if="{{alive}}" class="retire" bindtap="onRetire">坐化，结束这一世</view>
      <view class="reset" bindtap="onReset">重置存档</view>
    </block>
  </scroll-view>

  <view wx:if="{{sheet.kind}}" class="mask mask-sheet" catchtap="noop" catchtouchmove="noop">
    <view class="sheet">
      <view wx:if="{{tip.at === 'sheet'}}" class="tip tip-above tip-sheet" catchtap="noop">
        <view class="tip-text">{{tip.text}}</view>
        <view class="tip-row">
          <text class="tip-skip" bindtap="onTipSkip">跳过指引</text>
          <text wx:if="{{tip.next}}" class="tip-next" bindtap="onTipNext">{{tip.next}}</text>
        </view>
      </view>
      <block wx:if="{{sheet.kind === 'root'}}">
        <view class="sheet-type">投胎</view>
        <view class="sheet-title">{{sheet.title}}</view>
        <view class="sheet-text">{{sheet.text}}</view>
        <view wx:if="{{sheet.fate}}" class="fate-card">
          <view class="opt-head">
            <text class="opt-label">命格 · {{sheet.fate.name}}</text>
            <text class="opt-years">有得有失</text>
          </view>
          <view class="opt-desc">{{sheet.fate.desc}}</view>
          <view class="opt-note">{{sheet.fate.text}}</view>
        </view>
        <scroll-view scroll-y class="sheet-body">
          <view wx:for="{{sheet.options}}" wx:key="id" class="opt root-r{{item.rarity}}" hover-class="opt-hover" hover-stay-time="60" data-id="{{item.id}}" bindtap="onRoot">
            <view class="opt-head">
              <text class="opt-label">{{item.name}}</text>
              <text class="opt-years root-tag">{{item.rarityName}}</text>
            </view>
            <view class="opt-desc">{{item.desc}}</view>
            <view class="opt-note">{{item.text}}</view>
          </view>
        </scroll-view>
        <view class="sheet-actions">
          <view class="sheet-btn sheet-btn-plain {{sheet.rolls ? '' : 'root-reroll-off'}}" bindtap="onRootReroll">{{sheet.rollText}}</view>
        </view>
      </block>

      <block wx:elif="{{sheet.kind === 'event'}}">
        <view class="sheet-top">
          <view class="sheet-type">{{sheet.typeName}}</view>
          <view class="sheet-close" bindtap="onSheetClose">稍后再选</view>
        </view>
        <view class="sheet-title">{{sheet.title}}</view>
        <view class="sheet-text">{{sheet.text}}</view>
        <view wx:if="{{sheet.wake}}" class="sheet-wake">{{sheet.wake}}</view>
        <scroll-view scroll-y class="sheet-body">
          <view wx:for="{{sheet.options}}" wx:key="label" class="opt {{item.disabled ? 'opt-off' : ''}}" hover-class="opt-hover" hover-stay-time="60" data-index="{{index}}" bindtap="onOption">
            <view class="opt-head">
              <text class="opt-label">{{item.label}}</text>
              <text class="opt-years {{item.fatal ? 'opt-fatal' : ''}}">{{item.fatal ? '寿元将尽 · ' : ''}}耗 {{item.years}} 年</text>
            </view>
            <view class="opt-desc">{{item.desc}}</view>
            <view wx:if="{{item.disabled}}" class="opt-note">灵气不足</view>
          </view>
          <view class="opt opt-plain" hover-class="opt-hover" hover-stay-time="60" bindtap="onFallback">
            <view class="opt-head">
              <text class="opt-label">{{sheet.fallback.label}}</text>
              <text class="opt-years {{sheet.fallback.fatal ? 'opt-fatal' : ''}}">{{sheet.fallback.fatal ? '寿元将尽 · ' : ''}}耗 {{sheet.fallback.years}} 年</text>
            </view>
            <view class="opt-desc">{{sheet.fallback.desc}}</view>
          </view>
        </scroll-view>
        <view wx:if="{{sheet.rerolls}}" class="sheet-link" bindtap="onReroll">换一个机缘（还可重抽 {{sheet.rerolls}} 次）</view>
      </block>

      <block wx:elif="{{sheet.kind === 'sea'}}">
        <view class="sheet-top">
          <view class="sheet-type">{{sheet.route || '枯海'}} · 潮位 {{sheet.tide}} / {{sheet.maxTide}}</view>
          <view class="sheet-close" bindtap="onSheetClose">稍后再探</view>
        </view>
        <view class="sheet-title">{{sheet.title}}</view>
        <view class="sheet-text">{{sheet.text}}</view>
        <view wx:if="{{sheet.anchor}}" class="sheet-wake">已取得「{{sheet.anchor}}」</view>
        <scroll-view scroll-y class="sheet-body">
          <view wx:for="{{sheet.options}}" wx:key="id" class="opt {{item.disabled ? 'opt-off' : ''}}" hover-class="opt-hover" hover-stay-time="60" data-id="{{item.id}}" data-tide="{{sheet.tide}}" bindtap="onSeaOption">
            <view class="opt-label">{{item.label}}</view>
            <view class="opt-desc">{{item.desc}}</view>
            <view wx:if="{{item.note}}" class="opt-note">{{item.note}}</view>
          </view>
        </scroll-view>
        <view wx:if="{{sheet.retreat}}" class="sheet-link" bindtap="onSeaRetreat">结束本世探索，带着已有收获返航</view>
      </block>

      <block wx:elif="{{sheet.kind === 'yuan'}}">
        <view class="sheet-top">
          <view class="sheet-type">元婴劫 · 第 {{sheet.step}} 关</view>
          <view class="sheet-close" bindtap="onSheetClose">再等等</view>
        </view>
        <view class="sheet-title">{{sheet.title}}</view>
        <view class="sheet-text">{{sheet.text}}</view>
        <view class="sheet-wake">{{sheet.note}}</view>
        <scroll-view scroll-y class="sheet-body">
          <view wx:for="{{sheet.options}}" wx:key="id" class="opt {{item.disabled ? 'opt-off' : ''}}" hover-class="opt-hover" hover-stay-time="60" data-id="{{item.id}}" data-step="{{sheet.step}}" bindtap="onYuanMethod">
            <view class="opt-head">
              <text class="opt-label">{{item.label}}</text>
              <text class="opt-years">{{item.rate}}</text>
            </view>
            <view class="opt-desc">{{item.desc}}</view>
            <view wx:if="{{item.note}}" class="opt-note">{{item.note}}</view>
          </view>
        </scroll-view>
      </block>

      <block wx:elif="{{sheet.kind === 'trib'}}">
        <view class="sheet-top">
          <view class="sheet-type">渡劫三法</view>
          <view class="sheet-close" bindtap="onSheetClose">再等等</view>
        </view>
        <view class="sheet-title">{{sheet.title}}</view>
        <view class="sheet-text">{{sheet.text}}</view>
        <scroll-view scroll-y class="sheet-body">
          <view wx:for="{{sheet.options}}" wx:key="id" class="opt {{item.disabled ? 'opt-off' : ''}}" hover-class="opt-hover" hover-stay-time="60" data-method="{{item.id}}" bindtap="onTribMethod">
            <view class="opt-head"><text class="opt-label">{{item.label}}</text></view>
            <view class="opt-desc">{{item.desc}}</view>
            <view wx:if="{{item.note}}" class="opt-note">{{item.note}}</view>
          </view>
        </scroll-view>
      </block>

      <block wx:elif="{{sheet.kind === 'merge'}}">
        <view class="sheet-top">
          <view class="sheet-type">秘法合成</view>
          <view class="sheet-close" bindtap="onSheetClose">再想想</view>
        </view>
        <view class="sheet-title">{{sheet.title}}</view>
        <view class="sheet-text">{{sheet.text}}</view>
        <scroll-view scroll-y class="sheet-body">
          <view wx:for="{{sheet.options}}" wx:key="id" class="opt" hover-class="opt-hover" hover-stay-time="60" data-id="{{item.id}}" bindtap="onMergePick">
            <view class="opt-head"><text class="opt-label">加入{{item.name}}，炼成{{item.arcane}}</text></view>
            <view class="opt-desc">{{item.desc}}</view>
          </view>
        </scroll-view>
      </block>

      <block wx:elif="{{sheet.kind === 'result'}}">
        <view class="sheet-type">{{sheet.title}}</view>
        <view class="sheet-title">{{sheet.label}}</view>
        <view wx:if="{{sheet.text}}" class="sheet-text">{{sheet.text}}</view>
        <scroll-view scroll-y class="sheet-body">
          <view wx:for="{{sheet.lines}}" wx:key="key" class="result-line">{{item.text}}</view>
        </scroll-view>
        <view class="sheet-actions">
          <view class="sheet-btn sheet-btn-plain" bindtap="onResultOk">{{sheet.okText}}</view>
          <view wx:if="{{sheet.nextText}}" class="sheet-btn" bindtap="onResultNext">{{sheet.nextText}}</view>
        </view>
      </block>

      <block wx:elif="{{sheet.kind === 'replace'}}">
        <view class="sheet-top">
          <view class="sheet-type">功法已满</view>
          <view class="sheet-close" bindtap="onSheetClose">先看看羁绊</view>
        </view>
        <view class="sheet-title">{{sheet.title}}</view>
        <view class="sheet-text">{{sheet.text}}。最多同时持有 {{sheet.max}} 门功法，选一门旧的换掉，或者放弃新的。</view>
        <scroll-view scroll-y class="sheet-body">
          <view wx:for="{{sheet.options}}" wx:key="id" class="opt" hover-class="opt-hover" hover-stay-time="60" data-index="{{index}}" bindtap="onReplace">
            <view class="opt-head">
              <text class="opt-label">换掉{{item.name}}</text>
            </view>
            <view class="opt-desc">{{item.desc}}</view>
          </view>
          <view class="opt opt-plain" hover-class="opt-hover" hover-stay-time="60" data-index="-1" bindtap="onReplace">
            <view class="opt-head">
              <text class="opt-label">放弃新功法</text>
            </view>
          </view>
        </scroll-view>
      </block>

      <block wx:elif="{{sheet.kind === 'guide'}}">
        <view class="sheet-top">
          <view class="sheet-type">游戏指南</view>
          <view class="sheet-close" bindtap="onGuideClose">关闭</view>
        </view>
        <scroll-view scroll-y class="sheet-body guide-body">
          <view wx:for="{{sheet.rows}}" wx:key="key" class="{{item.head ? 'guide-title' : 'guide-line'}}">{{item.text}}</view>
        </scroll-view>
        <view class="sheet-actions">
          <view class="sheet-btn" bindtap="onGuideClose">知道了</view>
        </view>
      </block>

      <block wx:elif="{{sheet.kind === 'arena'}}">
        <view class="sheet-top">
          <view class="sheet-type">竞技场</view>
          <view class="sheet-close" bindtap="onArenaClose">关闭</view>
        </view>
        <view class="sheet-title">我的战力 {{sheet.power}} · 对战次数 {{sheet.left}}</view>
        <view class="sheet-text">{{sheet.standing}}<text wx:if="{{sheet.nextRank}}"> · {{sheet.nextRank}}</text></view>
        <view class="sheet-text">对手战力按境界和累计灯芯推算。胜了获论道积分，败了折寿。{{sheet.waitText}}连战时，寿元经不起一败会自动停手。</view>
        <scroll-view scroll-y class="sheet-body cloud-body">
          <view wx:if="{{sheet.error}}" class="cloud-error">{{sheet.error}}</view>
          <view wx:if="{{sheet.loading && !sheet.rows.length}}" class="empty">正在读取榜单…</view>
          <view wx:if="{{!sheet.rows.length && !sheet.loading && !sheet.error}}" class="empty">榜上还没有人，没有对手。</view>
          <view wx:for="{{sheet.rows}}" wx:key="id" class="rank-row {{item.mine ? 'rank-mine' : ''}}">
            <text class="rank-no">{{item.rank}}</text>
            <view class="rank-info">
              <text class="rank-name">{{item.name}}</text>
              <text class="rank-realm">{{item.realm}} · 战力 {{item.power}}</text>
              <text wx:if="{{!item.mine}}" class="rank-realm">{{item.gain}}</text>
            </view>
            <view wx:if="{{item.mine}}" class="arena-btn arena-btn-off">自己</view>
            <view wx:else class="arena-acts">
              <view class="arena-btn {{item.off ? 'arena-btn-off' : ''}}" data-id="{{item.id}}" bindtap="onArenaFight">
                <text class="arena-btn-title">挑战</text>
                <text class="arena-btn-sub">胜率 {{item.pct}}%</text>
              </view>
              <view wx:if="{{sheet.batch}}" class="arena-btn arena-btn-all {{item.off ? 'arena-btn-off' : ''}}" data-id="{{item.id}}" data-all="1" bindtap="onArenaFight">
                <text class="arena-btn-sub">连战 {{sheet.batch}} 场</text>
              </view>
            </view>
          </view>
        </scroll-view>
      </block>

      <block wx:elif="{{sheet.kind === 'cloud'}}">
        <view class="sheet-top">
          <view class="sheet-type">云存档</view>
          <view class="sheet-close" bindtap="onCloudClose">关闭</view>
        </view>
        <view class="sheet-title">{{cloud.signedIn ? cloud.daoName : '云端未登录'}}</view>
        <view class="sheet-text">{{cloud.text}}{{cloud.lastSync ? ' · 上次同步 ' + cloud.lastSync : ''}}</view>

        <view wx:if="{{cloud.signedIn}}" class="cloud-name-row">
          <block wx:if="{{cloud.editing}}">
            <input class="cloud-name-input" value="{{cloud.nameDraft}}" maxlength="12" confirm-type="done" placeholder="取一个道号" placeholder-class="cloud-name-ph" bindinput="onCloudNameInput" bindconfirm="onCloudNameSave" />
            <view class="cloud-name-btn" bindtap="onCloudNameSave">保存</view>
          </block>
          <block wx:else>
            <text class="cloud-name-text">道号 · {{cloud.daoName}}</text>
            <view class="cloud-name-btn" bindtap="onCloudNameEdit">改名</view>
          </block>
        </view>

        <scroll-view scroll-y class="sheet-body cloud-body">
          <view class="cloud-board-head">
            <text class="cloud-board-cap">全局排行榜</text>
            <text class="cloud-board-refresh" bindtap="onCloudRefresh">{{cloud.boardLoading ? '刷新中…' : '刷新'}}</text>
          </view>
          <view wx:if="{{cloud.boardError}}" class="cloud-error">{{cloud.boardError}}</view>
          <view wx:if="{{!cloud.rows.length && !cloud.boardLoading && !cloud.boardError}}" class="empty">榜上还没有人。同步一次，你就是第一个。</view>
          <view wx:for="{{cloud.rows}}" wx:key="id" class="rank-row {{item.mine ? 'rank-mine' : ''}}">
            <text class="rank-no">{{item.rank}}</text>
            <view class="rank-info">
              <text class="rank-name">{{item.name}}</text>
              <text class="rank-realm">{{item.realm}}</text>
            </view>
            <view class="rank-wick">
              <image class="rank-wick-icon" src="/assets/wick.svg" mode="aspectFit" />
              <text>{{item.wick}}</text>
            </view>
          </view>
          <view wx:if="{{cloud.myRank}}" class="cloud-myrank">我的名次 · 第 {{cloud.myRank}} 名</view>
        </scroll-view>

        <view class="sheet-actions">
          <view wx:if="{{!cloud.signedIn}}" class="sheet-btn" bindtap="onCloudLogin">微信登录</view>
          <block wx:else>
            <view class="sheet-btn sheet-btn-plain" bindtap="onCloudLogout">退出</view>
            <view class="sheet-btn" bindtap="onCloudSync">立即同步</view>
          </block>
        </view>
      </block>

      <block wx:elif="{{sheet.kind === 'chronicle'}}">
        <view class="sheet-top">
          <view class="sheet-type">本纪</view>
          <view class="sheet-close" bindtap="onChronicleClose">返回</view>
        </view>
        <view class="sheet-title">{{sheet.title}}</view>
        <view class="sheet-text">{{sheet.subtitle}}。{{sheet.intro}}</view>
        <scroll-view scroll-y class="sheet-body chronicle-body">
          <view wx:for="{{sheet.rows}}" wx:key="key" class="chronicle-row">
            <view class="chronicle-age">{{item.age}}</view>
            <view class="chronicle-entry">
              <view class="chronicle-title">{{item.title}}</view>
              <view class="chronicle-text">{{item.text}}</view>
              <view wx:if="{{item.detail}}" class="chronicle-detail">{{item.detail}}</view>
            </view>
          </view>
        </scroll-view>
        <view wx:if="{{sheet.error}}" class="cloud-error">{{sheet.error}}</view>
        <view class="sheet-actions">
          <view wx:if="{{sheet.busy}}" class="sheet-btn sheet-btn-plain">正在生成长图…</view>
          <button wx:elif="{{sheet.ready}}" class="sheet-btn share-btn" open-type="share">转发本纪长图</button>
          <view wx:else class="sheet-btn" bindtap="onChronicleShare">生成本纪长图</view>
        </view>
      </block>

      <block wx:else>
        <view class="sheet-type">身死</view>
        <view class="sheet-title">灯里有人叹了口气</view>
        <view class="sheet-text">{{sheet.text}}</view>
        <view class="sheet-wick">
          <image class="sheet-wick-icon" src="/assets/wick.svg" mode="aspectFit" />
          <text>灯芯 +{{sheet.wick}}</text>
        </view>
        <scroll-view scroll-y wx:if="{{sheet.carry.length}}" class="sheet-body">
          <view class="sheet-text">挑一门功法，以凡品带入下一世：</view>
          <view class="carry">
            <view wx:for="{{sheet.carry}}" wx:key="id" class="carry-item {{item.on ? 'carry-on' : ''}}" data-id="{{item.id}}" bindtap="onCarry">{{item.name}}</view>
          </view>
        </scroll-view>
        <view class="sheet-link" bindtap="onChronicle">查看本纪与分享长图</view>
        <view class="sheet-actions">
          <view class="sheet-btn sheet-btn-plain" bindtap="onDeadLamp">先去点灯纹</view>
          <view class="sheet-btn" bindtap="onReborn">再入轮回</view>
        </view>
      </block>
    </view>
  </view>

  <canvas wx:if="{{chronicleCanvas.show}}" type="2d" id="chronicleCanvas" class="chronicle-canvas" style="width: {{chronicleCanvas.width}}px; height: {{chronicleCanvas.height}}px;"></canvas>

  <view wx:if="{{banner}}" class="banner">{{banner}}</view>

  <view wx:if="{{modal.show}}" class="mask" catchtap="noop" catchtouchmove="noop">
    <view class="dialog">
      <view class="dialog-title">{{modal.title}}</view>
      <view wx:if="{{modal.highlight}}" class="dialog-highlight">{{modal.highlight}}</view>
      <view class="dialog-body">{{modal.content}}</view>
      <view class="dialog-actions">
        <view wx:if="{{modal.cancelText}}" class="dialog-btn dialog-cancel" bindtap="onModalCancel">{{modal.cancelText}}</view>
        <view class="dialog-btn {{modal.danger ? 'dialog-danger' : 'dialog-ok'}}" bindtap="onModalConfirm">{{modal.confirmText}}</view>
      </view>
    </view>
  </view>
</view>
