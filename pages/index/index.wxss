  36%, 47% { opacity: 0.9; transform: scale(1); }
  49% { opacity: 0.3; transform: scale(1.06); }
  55%, 66% { opacity: 0.8; transform: scale(1); }
  68% { opacity: 1; transform: scale(1.1); }
  76%, 100% { opacity: 0; transform: scale(1.7); }
}

@keyframes storm-body {
  0%, 29% { transform: translateX(0); filter: none; }
  30% { transform: translateX(-4rpx); filter: brightness(1.6); }
  34% { transform: translateX(4rpx); filter: brightness(1.3); }
  38%, 47% { transform: translateX(0); filter: none; }
  48% { transform: translateX(5rpx); filter: brightness(1.8); }
  52% { transform: translateX(-5rpx); filter: brightness(1.3); }
  56%, 66% { transform: translateX(0); filter: none; }
  67% { transform: translateX(-10rpx) scale(1.04); filter: brightness(3.2); }
  69% { transform: translateX(10rpx) scale(0.98); filter: brightness(0.4); }
  71% { transform: translateX(-9rpx) scale(1.04); filter: brightness(3.2); }
  74% { transform: translateX(8rpx); filter: brightness(3); }
  77% { transform: translateX(-6rpx); filter: brightness(0.5); }
  80% { transform: translateX(4rpx); filter: brightness(2); }
  86%, 100% { transform: translateX(0); filter: brightness(0.75); }
}

