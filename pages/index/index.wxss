/* 机缘面板 */
.mask {
  position: fixed;
  z-index: 30;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(6, 5, 8, 0.72);
}

.mask-sheet {
  z-index: 15;
  align-items: flex-end;
  /* 上半部分不遮，选择时仍能看到角色的动作 */
  background: linear-gradient(180deg, rgba(6, 5, 8, 0) 0, rgba(6, 5, 8, 0) 600rpx, rgba(6, 5, 8, 0.78) 780rpx);
}

.sheet {
  width: 100%;
  box-sizing: border-box;
  padding: 32rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid rgba(255, 200, 130, 0.25);
  border-radius: 36rpx 36rpx 0 0;
  background: linear-gradient(180deg, #33271f, #1b1715);
  box-shadow: 0 -16rpx 48rpx rgba(0, 0, 0, 0.5);
