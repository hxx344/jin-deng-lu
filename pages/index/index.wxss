.page {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  padding: 0 24rpx;
  padding-bottom: env(safe-area-inset-bottom);
  overflow: hidden;
  background: linear-gradient(180deg, #2b2019 0%, #1a1614 42%, #0d0c0e 100%);
}

/* 顶部：境界、灵气、寿元、心魔 */
.hud {
  flex-shrink: 0;
  padding-top: 20rpx;
}

.hud-top {
  display: flex;
  align-items: baseline;
}

.realm {
  font-size: 40rpx;
  font-weight: 800;
  color: #f6e7c8;
}

.where {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #a3988a;
}

.wick {
  display: flex;
  align-items: center;
  padding: 6rpx 20rpx 6rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 170, 70, 0.16);
  font-size: 26rpx;
  font-weight: 700;
  color: #ffcf8a;
}

.wick-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 6rpx;
}

.qi {
  display: flex;
  align-items: baseline;
  margin-top: 14rpx;
}

.qi-side {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  margin: 0 12rpx;
}

.qi-num {
  flex-shrink: 0;
  font-size: 68rpx;
  font-weight: 800;
  line-height: 1.1;
  white-space: nowrap;
  color: #8fe6c8;
}

.qi-cap {
  margin-right: 14rpx;
  font-size: 26rpx;
  color: #a3988a;
}

.qi-rate {
  font-size: 22rpx;
  white-space: nowrap;
  color: #6fc7a8;
}

.mode-tag {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(224, 74, 74, 0.22);
  font-size: 20rpx;
  font-weight: 600;
  color: #ff9c8f;
}

.hud-stats {
  display: flex;
  margin-top: 14rpx;
  padding: 8rpx 0;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.06);
}

.hud-stat {
  flex: 1;
  min-width: 0;
  border-left: 2rpx solid rgba(255, 255, 255, 0.07);
  text-align: center;
  white-space: nowrap;
}

.hud-stat:first-child {
  border-left: none;
}

.hud-stat-label {
  font-size: 19rpx;
  line-height: 1.3;
  color: #8c8275;
}

.hud-stat-num {
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.3;
  font-variant-numeric: tabular-nums;
  color: #f1e9dc;
}

.hud-stat-warn .hud-stat-num {
  color: #ff9c8f;
}

.power-badge {
  display: flex;
  flex-shrink: 0;
  align-self: center;
  align-items: baseline;
  margin-left: auto;
  padding: 7rpx 16rpx;
  border: 2rpx solid rgba(255, 191, 111, 0.25);
  border-radius: 14rpx;
  background: rgba(255, 191, 111, 0.08);
}

.power-label {
  margin-right: 10rpx;
  font-size: 22rpx;
  color: #dac5a7;
}

.power-value {
  font-size: 32rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  color: #ffcf8a;
}

.bar {
  height: 8rpx;
  margin-top: 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.1);
  overflow: hidden;
}

.bar-qi {
  height: 12rpx;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #3fae8e, #9ff0d2);
}

.chips {
  display: flex;
  margin: 16rpx -6rpx 0;
}

.chip {
  flex: 1;
  margin: 0 6rpx;
  padding: 8rpx 0;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.07);
  text-align: center;
  font-size: 22rpx;
  color: #a3988a;
  white-space: nowrap;
}

.chip-num {
  margin-left: 8rpx;
  font-weight: 600;
  color: #f1e9dc;
}

.chip-warn {
  background: rgba(224, 74, 74, 0.22);
}

.chip-warn .chip-num {
  color: #ff9c8f;
}

/* 场景：灯、角色和主按钮 */
.stage {
  position: relative;
  flex-shrink: 0;
  height: 330rpx;
  margin-top: 18rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 28rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #3b2b22 0%, #2a211c 55%, #1b1715 100%);
}

.stage-1 {
  background: linear-gradient(180deg, #2c333c 0%, #23272d 55%, #17181b 100%);
}

.stage-2 {
  background: linear-gradient(180deg, #182e38, #243f48 50%, #131e27 100%);
}

.stage-2 .scene-far {
  background: #344853;
}

.stage-2 .scene-near {
  background: #142c38;
  border-top: 2rpx solid rgba(171, 218, 222, 0.27);
}

.scene-far,
.scene-near,
.rib {
  position: absolute;
  border-radius: 50% 50% 0 0;
}

.scene-far {
  left: -10%;
  right: 30%;
  bottom: -80rpx;
  height: 200rpx;
  background: rgba(0, 0, 0, 0.2);
}

.scene-near {
  left: 45%;
  right: -30%;
  bottom: -100rpx;
  height: 210rpx;
  background: rgba(0, 0, 0, 0.28);
}

/* 骸山：角色坐在仙人的肋骨之间 */
.rib {
  display: none;
  bottom: -130rpx;
  border: 14rpx solid rgba(232, 226, 210, 0.13);
  border-bottom: none;
}

.stage-1 .rib {
  display: block;
}

.stage-1 .scene-far,
.stage-1 .scene-near {
  display: none;
}

.rib-1 { left: 5%; width: 90%; height: 400rpx; }
.rib-2 { left: 16%; width: 68%; height: 340rpx; }
.rib-3 { left: 27%; width: 46%; height: 280rpx; }

.lamp {
  position: absolute;
  left: 28rpx;
  bottom: 12rpx;
  width: 110rpx;
  height: 110rpx;
}

.lamp-glow {
  position: absolute;
  left: -30rpx;
  top: -50rpx;
  right: -30rpx;
  bottom: 10rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 180, 80, 0.5) 0%, rgba(255, 120, 40, 0.16) 45%, rgba(255, 120, 40, 0) 70%);
  animation: pulse 2.8s ease-in-out infinite;
}

.lamp-img {
  position: relative;
  width: 100%;
  height: 100%;
}

.lamp-flare .lamp-img {
  animation: lamp-flare 0.6s ease-out;
}

/* 没有肉身时（投胎前、身死后）绕着灯飘的一点魂火 */
.wisp {
  position: absolute;
  left: 110rpx;
  bottom: 120rpx;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: radial-gradient(circle, #fff 0%, #ffd9a0 40%, rgba(255, 150, 60, 0) 72%);
  animation: wisp 3.6s ease-in-out infinite;
}

.actor {
  position: absolute;
  left: 50%;
  bottom: 6rpx;
  width: 260rpx;
  height: 300rpx;
  margin-left: -130rpx;
}

.a-aura,
.a-mist,
.a-ring,
.a-cloud,
.a-bolt,
.a-shadow,
.a-float,
.a-body,
.a-halo,
.a-ribbon,
.a-legs,
.a-torso,
.a-sash,
.a-head,
.a-hair,
.a-bun,
.a-brow,
.a-eye,
.a-mouth,
.a-beard,
.a-arm,
.a-hand,
.a-sword,
.a-dot,
.a-prop,
.a-slash,
.a-bubble {
  position: absolute;
}

.a-aura {
  left: -10rpx;
  bottom: 0;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(143, 230, 200, 0.4) 0%, rgba(143, 230, 200, 0.12) 45%, rgba(143, 230, 200, 0) 70%);
  opacity: 0.4;
  animation: pulse 3.2s ease-in-out infinite;
}

.realm-1 .a-aura { opacity: 0.65; }
.realm-2 .a-aura { opacity: 0.9; }
.realm-3 .a-aura {
  opacity: 1;
  background: radial-gradient(circle, rgba(255, 220, 130, 0.5) 0%, rgba(255, 200, 100, 0.16) 45%, rgba(255, 200, 100, 0) 70%);
}

.a-mist {
  left: -20rpx;
  bottom: 0;
  width: 300rpx;
  height: 250rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(170, 20, 35, 0.6) 0%, rgba(120, 10, 30, 0.2) 50%, rgba(120, 10, 30, 0) 72%);
  opacity: 0;
}

.is-demon .a-mist {
  opacity: 0.45;
  animation: pulse 1.8s ease-in-out infinite;
}

.a-ring {
  left: 30rpx;
  bottom: 50rpx;
  width: 200rpx;
  height: 200rpx;
  box-sizing: border-box;
  border: 8rpx solid rgba(255, 224, 140, 0.95);
  border-radius: 50%;
  opacity: 0;
}

.a-cloud {
  left: 40rpx;
  top: -6rpx;
  width: 180rpx;
  height: 46rpx;
  border-radius: 23rpx;
  background: rgba(70, 66, 96, 0.9);
  box-shadow: 40rpx 10rpx 0 -6rpx rgba(56, 52, 80, 0.9), -36rpx 12rpx 0 -8rpx rgba(56, 52, 80, 0.9);
  opacity: 0;
  transition: opacity 0.4s;
}

.is-ready .a-cloud {
  opacity: 0.85;
  animation: cloud 2.4s ease-in-out infinite;
}

.a-bolt {
  left: 85rpx;
  top: 20rpx;
  width: 90rpx;
  height: 190rpx;
  opacity: 0;
}

/* 影子和蒲团 */
.a-shadow {
  left: 26rpx;
  bottom: 0;
  width: 208rpx;
  height: 30rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.45);
}

.a-shadow::before {
  content: '';
  position: absolute;
  left: 10rpx;
  right: 10rpx;
  top: -12rpx;
  height: 34rpx;
  border-radius: 50%;
  border-bottom: 6rpx solid #3a2a1c;
  background: linear-gradient(180deg, #8a6a44, #5c452c);
}

.a-float {
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  animation: a-bob 3.2s ease-in-out infinite;
}

.a-body {
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  transform-origin: 50% 88%;
}

/* 金丹：脑后的丹晕 */
.a-halo {
  display: none;
  left: 50rpx;
  bottom: 112rpx;
  width: 160rpx;
  height: 160rpx;
  box-sizing: border-box;
  border: 5rpx solid rgba(255, 224, 140, 0.85);
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 230, 150, 0) 52%, rgba(255, 230, 150, 0.28) 70%);
  box-shadow: 0 0 24rpx rgba(255, 210, 110, 0.55);
}

.a-halo::after {
  content: '';
  position: absolute;
  left: -20rpx;
  top: -20rpx;
  right: -20rpx;
  bottom: -20rpx;
  border: 4rpx dashed rgba(255, 224, 140, 0.55);
  border-radius: 50%;
  animation: a-turn 14s linear infinite;
}

.realm-3 .a-halo {
  display: block;
}

/* 筑基起：身后的飘带 */
.a-ribbon {
  display: none;
  bottom: 44rpx;
  width: 20rpx;
  height: 130rpx;
  border-radius: 10rpx;
  background: linear-gradient(180deg, rgba(143, 230, 200, 0.85), rgba(143, 230, 200, 0));
  transform-origin: 50% 100%;
}

.a-ribbon-l {
  left: 62rpx;
  transform: rotate(-34deg);
  animation: a-sway-l 2.8s ease-in-out infinite alternate;
}

.a-ribbon-r {
  left: 178rpx;
  transform: rotate(34deg);
  animation: a-sway-r 2.8s ease-in-out infinite alternate;
}

.realm-2 .a-ribbon,
.realm-3 .a-ribbon {
  display: block;
}

.realm-3 .a-ribbon {
  background: linear-gradient(180deg, rgba(255, 220, 130, 0.9), rgba(255, 220, 130, 0));
}

.a-legs {
  left: 40rpx;
  bottom: 18rpx;
  width: 180rpx;
  height: 60rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #6b5c4f;
}

.a-legs::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.14) 0%, rgba(0, 0, 0, 0) 45%, rgba(0, 0, 0, 0.28) 100%);
}

.a-legs::after {
  content: '';
  position: absolute;
  left: 44rpx;
  top: 22rpx;
  width: 92rpx;
  height: 40rpx;
  box-sizing: border-box;
  border-top: 4rpx solid rgba(0, 0, 0, 0.22);
  border-radius: 50%;
}

.a-torso {
  left: 80rpx;
  bottom: 48rpx;
  width: 100rpx;
  height: 104rpx;
  border-radius: 46rpx 46rpx 30rpx 30rpx;
  overflow: hidden;
  background: #8a7868;
}

.a-torso::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(90deg, rgba(0, 0, 0, 0.22) 0%, rgba(0, 0, 0, 0) 32%, rgba(255, 255, 255, 0.08) 50%, rgba(0, 0, 0, 0) 68%, rgba(0, 0, 0, 0.22) 100%);
}

/* 交领：露出一角里衣 */
.a-torso::after {
  content: '';
  position: absolute;
  left: 22rpx;
  top: -30rpx;
  width: 56rpx;
  height: 56rpx;
  box-sizing: border-box;
  border-right: 9rpx solid rgba(255, 255, 255, 0.5);
  border-bottom: 9rpx solid rgba(255, 255, 255, 0.5);
  background: #f3ede2;
  transform: rotate(45deg);
}

.a-sash {
  left: 0;
  right: 0;
  bottom: 22rpx;
  height: 14rpx;
}

.a-sash::after {
  content: '';
  position: absolute;
  left: 50%;
  top: -3rpx;
  width: 20rpx;
  height: 30rpx;
  margin-left: -10rpx;
  border-radius: 5rpx;
  background: inherit;
  box-shadow: 0 0 0 2rpx rgba(0, 0, 0, 0.18);
}

.a-arm {
  z-index: 2;
  bottom: 62rpx;
  width: 32rpx;
  height: 76rpx;
  border-radius: 16rpx 16rpx 14rpx 14rpx;
  background: #9a8878;
  box-shadow: inset -6rpx 0 0 rgba(0, 0, 0, 0.12);
  transform-origin: 50% 14rpx;
  transition: transform 0.25s ease-out;
}

/* 袖口 */
.a-arm::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 10rpx;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.4);
}

.a-arm-l {
  left: 62rpx;
  transform: rotate(-32deg);
}

.a-arm-r {
  left: 166rpx;
  transform: rotate(32deg);
}

.realm-1 .a-legs { background: #4a6585; }
.realm-1 .a-torso { background: #6a8cb2; }
.realm-1 .a-arm { background: #7b9dc2; }
.realm-2 .a-legs { background: #25705f; }
.realm-2 .a-torso { background: #3a9a84; }
.realm-2 .a-arm { background: #4fae98; }
.realm-3 .a-legs { background: #c09a45; }
.realm-3 .a-torso { background: #f2e4bc; }
.realm-3 .a-arm { background: #f7edd2; }
.realm-4 .a-legs { background: #416894; }
.realm-4 .a-torso { background: #b5d6ec; }
.realm-4 .a-arm { background: #d9f0f7; }
.realm-4 .a-aura { opacity: 0.95; }

.realm-3 .a-torso::after {
  border-color: #d9aa3c;
}

.realm-3 .a-arm::after {
  background: #d9aa3c;
}

.a-hand {
  z-index: 1;
  left: 4rpx;
  bottom: -6rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #f4d2b0;
  box-shadow: inset -3rpx -3rpx 0 rgba(190, 120, 80, 0.25);
}

.a-sword {
  left: 12rpx;
  top: 60rpx;
  width: 8rpx;
  height: 130rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #8a6a3a 0%, #8a6a3a 16%, #f1f6ff 16%, #9fb6d8 100%);
  opacity: 0;
}

.a-head {
  z-index: 1;
  left: 74rpx;
  bottom: 136rpx;
  width: 112rpx;
  height: 104rpx;
  border-radius: 50% 50% 48% 48%;
  background: radial-gradient(circle at 50% 38%, #fde3c8 0%, #f4d2b0 60%, #e6b993 100%);
  transition: transform 0.25s ease-out;
}

/* 腮红 */
.a-head::before,
.a-head::after {
  content: '';
  position: absolute;
  top: 70rpx;
  width: 20rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(240, 120, 110, 0.38);
}

.a-head::before { left: 10rpx; }
.a-head::after { right: 10rpx; }

.a-hair {
  left: -5rpx;
  right: -5rpx;
  top: -8rpx;
  height: 54rpx;
  border-radius: 62rpx 62rpx 26rpx 26rpx;
  background: #2b2420;
}

/* 两鬓垂下的发丝 */
.a-hair::before,
.a-hair::after {
  content: '';
  position: absolute;
  top: 34rpx;
  width: 16rpx;
  height: 50rpx;
  border-radius: 0 0 10rpx 10rpx;
  background: inherit;
}

.a-hair::before { left: 0; }
.a-hair::after { right: 0; }

.a-bun {
  left: 36rpx;
  top: -38rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #2b2420;
}

/* 发簪 */
.a-bun::after {
  content: '';
  position: absolute;
  left: -14rpx;
  top: 24rpx;
  width: 68rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: linear-gradient(90deg, #f6d27a, #b8862a);
  transform: rotate(-10deg);
}

.a-brow {
  top: 48rpx;
  width: 20rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #3a2a22;
}

.a-brow-l {
  left: 22rpx;
  transform: rotate(-8deg);
}

.a-brow-r {
  right: 22rpx;
  transform: rotate(8deg);
}

.a-eye {
  top: 58rpx;
  width: 16rpx;
  height: 18rpx;
  border-radius: 50%;
  overflow: hidden;
  background: radial-gradient(circle 3rpx at 6rpx 8rpx, #fff 95%, rgba(255, 255, 255, 0) 100%), #2e211b;
}

.a-eye-l { left: 26rpx; }
.a-eye-r { right: 26rpx; }

.is-demon .a-eye {
  background: #e0402f;
  box-shadow: 0 0 10rpx #ff5a3c;
}

.is-demon .a-brow-l { transform: rotate(18deg); }
.is-demon .a-brow-r { transform: rotate(-18deg); }

.a-mouth {
  left: 50rpx;
  top: 84rpx;
  width: 12rpx;
  height: 5rpx;
  border-radius: 0 0 8rpx 8rpx;
  background: #b5654a;
}

.a-beard {
  display: none;
  left: 38rpx;
  top: 90rpx;
  width: 36rpx;
  height: 42rpx;
  border-radius: 6rpx 6rpx 18rpx 18rpx;
  background: linear-gradient(180deg, #f4f1ea, #d9d4c8);
}

/* 寿元将尽：白发、长须 */
.is-old .a-hair,
.is-old .a-bun,
.is-old .a-brow {
  background: #e6e2da;
}

.is-old .a-beard {
  display: block;
}

.a-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #9ff0d2;
  box-shadow: 0 0 8rpx #9ff0d2;
  opacity: 0;
}

.a-dot-1 { left: 36rpx; bottom: 30rpx; animation: a-rise-1 2.6s linear infinite; }
.a-dot-2 { left: 214rpx; bottom: 50rpx; animation: a-rise-2 2.6s linear 0.9s infinite; }
.a-dot-3 { left: 122rpx; bottom: 0; animation: a-rise-3 2.6s linear 1.7s infinite; }

.a-prop,
.a-slash {
  opacity: 0;
}

.a-bubble {
  z-index: 4;
  left: 176rpx;
  top: 30rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx 20rpx 20rpx 4rpx;
  background: rgba(255, 248, 235, 0.95);
  font-size: 24rpx;
  font-weight: 700;
  color: #3d2a1c;
  white-space: nowrap;
  animation: a-pop 0.25s ease-out;
}
/* 打坐、吐纳、闭关、静心、倒下时闭眼 */
.act-idle .a-eye,
.act-absorb .a-eye,
.act-seclude .a-eye,
.act-calm .a-eye,
.act-die .a-eye {
  top: 62rpx;
  height: 4rpx;
  border-radius: 4rpx;
  box-shadow: none;
}

/* 遇到机缘：一惊 */
.act-notice .a-body {
  animation: a-hop 0.4s ease-out;
}

/* 斟酌选项：歪头托腮 */
.act-ponder .a-head {
  transform: rotate(-7deg);
}

.act-ponder .a-arm-r {
  transform: rotate(140deg);
}

