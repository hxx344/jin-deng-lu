}

/* 来犯的东西：外层管入场和退场，中层管扑上来，里层管呼吸和受击。 */
.foe {
  position: absolute;
  right: 44rpx;
  bottom: 16rpx;
  width: 150rpx;
  height: 150rpx;
}

.foe-boss {
  right: 26rpx;
  width: 200rpx;
  height: 200rpx;
}

.foe-aura,
.foe-shadow,
.foe-move,
.foe-bob,
.foe-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.foe-aura {
  display: none;
  left: -20%;
  top: -10%;
  width: 140%;
  height: 120%;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(232, 98, 60, 0.38) 0%, rgba(232, 98, 60, 0.12) 45%, rgba(232, 98, 60, 0) 70%);
  animation: pulse 2s ease-in-out infinite;
}

.foe-boss .foe-aura {
  display: block;
}

.foe-shadow {
  left: 14%;
  top: auto;
  bottom: -6rpx;
  width: 72%;
  height: 20rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.38);
}

.foe-bob {
  transform-origin: 50% 100%;
  animation: foe-bob 1.4s ease-in-out infinite;
}

.foe-img {
  transform-origin: 50% 100%;
}

.foe-in {
  animation: foe-in 0.7s ease-out both;
}

.foe-out {
  animation: foe-out 0.7s ease-in both;
}

.foe-out .foe-img {
  filter: brightness(1.8) saturate(0.4);
}

.foe-away {
  animation: foe-away 0.9s ease-in both;
}

.foe-lunge1 {
  animation: foe-lunge-a 0.36s ease-out;
}

.foe-lunge2 {
  animation: foe-lunge-b 0.36s ease-out;
}

.foe-hit1 {
  animation: foe-hit-a 0.3s ease-out;
}

.foe-hit2 {
  animation: foe-hit-b 0.3s ease-out;
}

@keyframes foe-bob {
  0%, 100% { transform: scale(1, 1); }
  50% { transform: scale(1.03, 0.96); }
}

@keyframes foe-in {
  0% { opacity: 0; transform: translate(240rpx, 0); }
  25% { opacity: 1; transform: translate(180rpx, -22rpx); }
  50% { transform: translate(120rpx, 0); }
  75% { transform: translate(60rpx, -18rpx); }
  100% { opacity: 1; transform: translate(0, 0); }
}

@keyframes foe-out {
  0% { opacity: 1; transform: translate(0, 0) rotate(0); }
  30% { opacity: 1; transform: translate(26rpx, -30rpx) rotate(14deg); }
  100% { opacity: 0; transform: translate(70rpx, 10rpx) rotate(50deg) scale(0.6); }
}

@keyframes foe-away {
  0% { opacity: 1; transform: translate(0, 0); }
  100% { opacity: 0; transform: translate(260rpx, 0); }
}

@keyframes foe-lunge-a {
  40% { transform: translate(-150rpx, -12rpx) rotate(-8deg); }
}

@keyframes foe-lunge-b {
  40% { transform: translate(-150rpx, -12rpx) rotate(-8deg); }
}

@keyframes foe-hit-a {
  15% { transform: translateX(14rpx) scale(0.94, 1.04); filter: brightness(2.4); }
  50% { transform: translateX(-6rpx); filter: brightness(1.2); }
}

@keyframes foe-hit-b {
  15% { transform: translateX(14rpx) scale(0.94, 1.04); filter: brightness(2.4); }
  50% { transform: translateX(-6rpx); filter: brightness(1.2); }
}

/* 他打出去的那一下：一道剑气从身前飞到对面。 */
.shot {
  position: absolute;
  left: 290rpx;
  bottom: 118rpx;
  width: 84rpx;
  height: 30rpx;
  border-radius: 50%;
  opacity: 0;
  background: radial-gradient(ellipse at 78% 50%, #ffffff 0%, #b6f5e0 28%, rgba(111, 199, 168, 0.5) 52%, rgba(111, 199, 168, 0) 72%);
}

.shot-crit {
  bottom: 106rpx;
  width: 120rpx;
  height: 54rpx;
  background: radial-gradient(ellipse at 78% 50%, #ffffff 0%, #ffe9a8 28%, rgba(255, 178, 74, 0.6) 52%, rgba(255, 178, 74, 0) 72%);
}

.shot-extra {
  height: 14rpx;
  bottom: 140rpx;
  background: linear-gradient(90deg, rgba(200, 230, 255, 0) 0%, #cfe6ff 60%, #ffffff 100%);
}

.shot-charm {
  width: 30rpx;
  height: 44rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #b5463a 0%, #b5463a 18%, #f0deaa 18%, #d9bd78 100%);
}

.shot-go1 {
  animation: shot-a 0.3s ease-in;
}

.shot-go2 {
  animation: shot-b 0.3s ease-in;
}

@keyframes shot-a {
  0% { opacity: 0; transform: translateX(0) scaleX(0.5); }
  20% { opacity: 1; }
  85% { opacity: 1; transform: translateX(250rpx) scaleX(1.2); }
  100% { opacity: 0; transform: translateX(280rpx) scaleX(0.4); }
}

@keyframes shot-b {
  0% { opacity: 0; transform: translateX(0) scaleX(0.5); }
  20% { opacity: 1; }
  85% { opacity: 1; transform: translateX(250rpx) scaleX(1.2); }
  100% { opacity: 0; transform: translateX(280rpx) scaleX(0.4); }
}

/* 他挨打时身上闪一下红 */
.fray-flash {
  position: absolute;
  left: 150rpx;
  bottom: 20rpx;
  width: 230rpx;
  height: 230rpx;
  border-radius: 50%;
  opacity: 0;
  background: radial-gradient(circle, rgba(255, 120, 90, 0.6) 0%, rgba(255, 90, 70, 0.2) 45%, rgba(255, 90, 70, 0) 70%);
}

.fray-flash1 {
  animation: fray-flash-a 0.4s ease-out 0.12s;
}

.fray-flash2 {
  animation: fray-flash-b 0.4s ease-out 0.12s;
}

@keyframes fray-flash-a {
  20% { opacity: 1; transform: scale(1.1); }
}

@keyframes fray-flash-b {
  20% { opacity: 1; transform: scale(1.1); }
}

.pop {
  position: absolute;
  font-size: 30rpx;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
  line-height: 1;
  white-space: nowrap;
  color: #fff4dc;
  opacity: 0;
  text-shadow: 0 2rpx 0 #3a1c10, 0 -2rpx 0 #3a1c10, 2rpx 0 0 #3a1c10, -2rpx 0 0 #3a1c10, 0 4rpx 6rpx rgba(0, 0, 0, 0.5);
  animation: pop-up 0.9s ease-out;
}

.pop-foe {
  right: 90rpx;
  bottom: 176rpx;
}

.pop-tall.pop-foe {
  bottom: 220rpx;
}

.pop-me {
  left: 250rpx;
  bottom: 236rpx;
}

.pop-crit {
  font-size: 42rpx;
  color: #ffc24d;
  animation-name: pop-crit;
}

.pop-thorns {
  font-size: 24rpx;
  color: #cfe6ff;
}

.pop-hurt {
  color: #ff9c8f;
}

.pop-heal {
  color: #9af0bd;
}

.pop-call {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(20, 14, 10, 0.78);
  font-size: 20rpx;
  font-weight: 700;
  color: #ffd9a0;
  text-shadow: none;
  animation-duration: 1.3s;
}

.pop-foe.pop-call {
  bottom: 214rpx;
}

@keyframes pop-up {
  0% { opacity: 0; transform: translateY(16rpx) scale(0.7); }
  18% { opacity: 1; transform: translateY(-6rpx) scale(1.12); }
  35% { transform: translateY(-14rpx) scale(1); }
  75% { opacity: 1; }
  100% { opacity: 0; transform: translateY(-58rpx) scale(1); }
}

@keyframes pop-crit {
  0% { opacity: 0; transform: translateY(16rpx) scale(0.6) rotate(-8deg); }
  16% { opacity: 1; transform: translateY(-10rpx) scale(1.5) rotate(4deg); }
  34% { transform: translateY(-18rpx) scale(1) rotate(0); }
  75% { opacity: 1; }
  100% { opacity: 0; transform: translateY(-66rpx) scale(1); }
}

/* 秘境：打关隘材料时场景换成秘境的图 */
.scene-art {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  animation: scene-art-in 0.5s ease-out both;
}

@keyframes scene-art-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

.stage-gate .scene-far,
.stage-gate .scene-near,
.stage-gate .rib {
  display: none;
}

.gate-btn {
  background: linear-gradient(180deg, #f0c9a6, #b0623c);
  box-shadow: 0 6rpx 0 #6e3419;
  color: #2e1408;
}

.gate-foe {
  flex-shrink: 0;
  width: 96rpx;
  height: 96rpx;
  margin-right: 16rpx;
}

.gate-gain {
  color: #ffd98a;
}

.gate-reason {
  padding: 20rpx 0 8rpx;
  text-align: center;
  font-size: 24rpx;
  color: #ff9c8f;
}
