.scroll-caption { color: #e6b97c; font-size: 24rpx; }
.scroll-title, .scroll-name, .scroll-seal { font-family: "Songti SC", "STSong", "SimSun", serif; }
.scroll-leaf {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 8rpx;
  border-top: 1rpx solid #705641;
}
.scroll-seal {
  flex: none;
  width: 58rpx;
  height: 62rpx;
  margin-right: 20rpx;
  border: 2rpx solid currentColor;
  border-radius: 7rpx 3rpx 8rpx 3rpx;
  color: #eac081;
  text-align: center;
  line-height: 62rpx;
  font-size: 38rpx;
}
.scroll-sword .scroll-seal { color: #aacfe4; }
.scroll-pill .scroll-seal { color: #a9d7b8; }
.scroll-talisman .scroll-seal { color: #cfb9e7; }
.scroll-body .scroll-seal { color: #e8b293; }
.scroll-copy { flex: 1; min-width: 0; }
.scroll-name { font-size: 34rpx; font-weight: 700; color: #ffead0; }
.scroll-rank { flex: none; margin-left: 8rpx; font-size: 22rpx; color: #d1ac84; }
.scroll-move { margin-top: 6rpx; font-size: 25rpx; line-height: 1.45; color: #ead7c1; }
.scroll-stats { margin-top: 4rpx; font-size: 22rpx; line-height: 1.4; color: #c4af99; }
.result-impact { margin-top: 10rpx; color: #ffcd84; font-size: 32rpx; font-weight: 700; }
.result-sparks { margin-top: 12rpx; }

.sheet-wick {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  font-size: 48rpx;
  font-weight: 800;
  color: #ffcf8a;
}

.sheet-wick-icon {
  width: 56rpx;
  height: 56rpx;
  margin-right: 10rpx;
}

.carry {
  display: flex;
  flex-wrap: wrap;
  margin: 12rpx -6rpx 0;
}

.carry-item {
  margin: 6rpx;
  padding: 10rpx 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #cfc4b3;
}

.carry-on {
  border-color: #ffcf8a;
  background: rgba(255, 170, 70, 0.2);
  font-weight: 600;
  color: #ffcf8a;
}

.sheet-actions {
  display: flex;
  margin: 24rpx -8rpx 0;
}

.sheet-btn {
  flex: 1;
  margin: 0 8rpx;
  padding: 22rpx 0;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #ffd27a, #f08a2e);
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #3d1f00;
}

.sheet-btn-plain {
  background: rgba(255, 255, 255, 0.1);
  color: #d8cdbd;
}

.help {
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  margin-left: 14rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 52rpx;
  color: #d8cdbd;
}

.sheet-wake {
  margin-top: 12rpx;
  padding: 10rpx 18rpx;
  border-radius: 14rpx;
  background: rgba(120, 220, 200, 0.12);
  font-size: 24rpx;
  color: #9fe3d2;
}

.help-off {
  color: #6f675c;
  text-decoration: line-through;
}

.marks {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 6rpx;
}

.mark {
  margin: 0 10rpx 10rpx 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 180, 80, 0.14);
  font-size: 24rpx;
  color: #f3c98a;
}

.guide-body {
  max-height: 60vh;
}

.guide-title {
  margin: 20rpx 0 10rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #ffcf8a;
}

.guide-line {
  position: relative;
  margin-bottom: 10rpx;
  padding-left: 26rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #cfc4b3;
}

.guide-line::before {
  content: '';
  position: absolute;
  left: 4rpx;
  top: 16rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #8fe6c8;
}

/* 初次游戏的点击指引 */
.hud,
.hero,
.tabs,
.sheet {
  position: relative;
}

.tip {
  position: absolute;
  z-index: 20;
  left: 0;
  right: 0;
  padding: 18rpx 24rpx 14rpx;
  border: 2rpx solid #8fe6c8;
  border-radius: 22rpx;
  background: #17322b;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.55);
  animation: tip-bob 1.4s ease-in-out infinite;
}

.tip::after {
  content: '';
  position: absolute;
  left: 80rpx;
  width: 22rpx;
  height: 22rpx;
  background: #17322b;
  border: 2rpx solid #8fe6c8;
  border-left: none;
  border-top: none;
}

.tip-above {
  bottom: 100%;
  margin-bottom: 18rpx;
}

.tip-above::after {
  bottom: -14rpx;
  transform: rotate(45deg);
}

.tip-below {
  top: 100%;
  margin-top: 22rpx;
}

.tip-below::after {
  top: -14rpx;
  transform: rotate(225deg);
}

.tip-sheet {
  left: 24rpx;
  right: 24rpx;
}

.tip-help {
  top: 74rpx;
  margin-top: 0;
}

.tip-help::after {
  left: auto;
  right: 14rpx;
}

.tip-text {
  font-size: 27rpx;
  line-height: 1.55;
  color: #e9fff6;
}

.tip-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}

.tip-skip {
  padding: 8rpx 0;
  font-size: 22rpx;
  color: #7fa89a;
}

.tip-next {
  padding: 8rpx 28rpx;
  border-radius: 999rpx;
  background: #8fe6c8;
  font-size: 24rpx;
  font-weight: 700;
  color: #10261f;
}

.tip-ring {
  box-shadow: 0 0 0 6rpx #8fe6c8, 0 0 30rpx 10rpx rgba(143, 230, 200, 0.6);
}

@keyframes tip-bob {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-6rpx); }
}

/* 提示条与弹窗 */
.banner {
  position: fixed;
  z-index: 40;
  left: 48rpx;
  right: 48rpx;
  top: 24rpx;
  padding: 20rpx 28rpx;
  border-radius: 22rpx;
  background: rgba(44, 34, 26, 0.97);
  border: 2rpx solid rgba(255, 200, 130, 0.5);
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.45);
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #ffe2b0;
  animation: banner-in 0.25s ease-out;
}

.dialog {
  width: 580rpx;
  padding: 44rpx 40rpx 36rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 32rpx;
  background: linear-gradient(180deg, #3a2c22, #1e1a17);
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.5);
  text-align: center;
  animation: dialog-in 0.2s ease-out;
}

.dialog-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #f6e7c8;
}

.dialog-highlight {
  margin-top: 20rpx;
  font-size: 52rpx;
  font-weight: 800;
  color: #ffcf8a;
}

.dialog-body {
  margin-top: 20rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #cfc4b3;
}

.dialog-actions {
  display: flex;
  margin: 36rpx -10rpx 0;
}

.dialog-btn {
  flex: 1;
  margin: 0 10rpx;
  padding: 20rpx 0;
  border-radius: 22rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.dialog-cancel {
  background: rgba(255, 255, 255, 0.1);
  color: #d8cdbd;
}

.dialog-ok {
  background: linear-gradient(180deg, #ffd27a, #f08a2e);
  color: #3d1f00;
}

.dialog-danger {
  background: linear-gradient(180deg, #ff8a8a, #e04a5a);
  color: #fff;
}

